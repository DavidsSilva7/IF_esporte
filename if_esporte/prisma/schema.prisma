generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANIZADOR
  REPRESENTANTE
}
enum StatusEvento{
   PLANEJADO
   ABERTO
   ENCERRADO
   CANCELADO
}
enum TipoPreparacao{
    SELETIVA
    TREINAMENTO
}
enum StatusInscricao{
    PENDENTE
    CONFIRMADA
    CANCELADA
}
enum StatusPartida {
    AGENDADA
    EM_ANDAMENTO
    FINALIZADA
    CANCELADA
}

model Usuario {
    id        Int      @id @default(autoincrement())
    nome      String
    email     String   @unique
    senha     String
    dataCriacao DateTime @default(now())
    dataAtualizacao DateTime @updatedAt
    role Role @default(ADMIN)
   
    campusId  Int? 
    campus Campus? @relation(fields:[campusId], references:[id])
    eventosOrganizados Evento[] @relation("OrganizadorEvento")
    inscricoes Inscricao[]   
}
model Campus {
    id       Int @id @default(autoincrement())
    nome     String
    sigla    String @unique
    cidade   String
    
    usuarios Usuario[]
    eventos  Evento[]
    partidasComoA Partida[] @relation("CampusAPartida")
    partidasComoB Partida[] @relation("CampusBPartida")
}
model Evento {
    id            Int @id @default(autoincrement())
    titulo        String
    descricao     String
    dataInicio    DateTime
    dataFim       DateTime
    local         String
    status        StatusEvento @default(PLANEJADO)
    campusId      Int
    organizadorId Int
    
    campus        Campus @relation(fields: [campusId], references: [id])
    organizador   Usuario @relation("OrganizadorEvento", fields: [organizadorId], references: [id])
    modalidades EventoModalidade[]
    inscricoes Inscricao[]
    partidas Partida[]
}
model Modalidade{
    id      Int @id @default(autoincrement())
    nome    String @unique
    eventos EventoModalidade[]
}
model EventoModalidade{
    eventoId     Int 
    modalidadeId Int 
    
    evento Evento @relation(fields:[eventoId], references:[id])
    modalidade Modalidade @relation(fields:[modalidadeId], references:[id])
    @@id([eventoId, modalidadeId])
}
model Inscricao{
    id          Int @id @default(autoincrement())
    usuarioId   Int
    eventoId    Int
    status      StatusInscricao @default(PENDENTE)
    dataInscricao DateTime @default(now())
    usuario Usuario @relation(fields:[usuarioId], references:[id])
    evento Evento @relation(fields:[eventoId], references:[id])
    @@unique([usuarioId, eventoId])
}
model Preparacao {
    id            Int @id @default(autoincrement())
    titulo        String
    descricao     String
    tipo          TipoPreparacao
    modalidadeId  Int
    campusId      Int
    responsavelId Int
    vagas         Int?
    local         String
    dataInicio    DateTime
    dataFim       DateTime

    modalidade Modalidade @relation(fields: [modalidadeId], references: [id])
    campus     Campus     @relation(fields: [campusId], references: [id])
    responsavel Usuario   @relation(fields: [responsavelId], references: [id])
}
model Partida {
    id          Int @id @default(autoincrement())
    eventoId    Int
    modalidadeId Int
    campusAId   Int
    campusBId   Int
    dataHora    DateTime
    local       String
    placarA     Int @default(0)
    placarB     Int @default(0)
    status      StatusPartida  @default(AGENDADA)

    evento      Evento @relation(fields: [eventoId], references: [id])
    modalidade  Modalidade @relation(fields: [modalidadeId], references: [id])
    campusA     Campus @relation("CampusAPartida", fields: [campusAId], references: [id])
    campusB     Campus @relation("CampusBPartida", fields: [campusBId], references: [id])
}